{
  "manifest_version": 3,
  "name": "Comet",
  "version": "0.1.0",
  "description": "Real-time comment overlay for any webpage",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "alarms", "storage"],
  "host_permissions": [
    "https://*.cloudfront.net/*",
    "https://*.amplifyapp.com/*",
    "https://*.execute-api.ap-northeast-1.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://*/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/toolbar-48.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
