{
  "name": "comet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "description": "Real-time audience comment overlay system",
  "workspaces": [
    "packages/*",
    "packages/api/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @comet/shared build",
    "dev": "pnpm -r --parallel dev",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "lint": "eslint packages scripts --ext .ts,.tsx,.js,.mjs,.cjs --max-warnings 0 && pnpm --filter @comet/web lint",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@types/node": "^26.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  }
}
